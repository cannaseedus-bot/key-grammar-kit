                        "law:infer_relation_from_lexical(x)≠VerifiedRelation(x)",
                        "law:Representation→Relevance→Candidate→Verification",
                        "fatal:MISSING_NODE_ID/DUPLICATE_NODE_ID/MISSING_EDGE_ENDPOINT/INVALID_EDGE_ENDPOINT/OVERLAY_ID_COLLISION_INTRA",
                        "error:CONFIDENCE_OUT_OF_RANGE/STATIC_WEIGHT_OUT_OF_RANGE/HEALTH_OUT_OF_RANGE/COORDINATE_NOT_FINITE",
                        "warning:NEAR_MISS_VERB/INFER_CANDIDATE_USED/BOTH_VERB_AND_RELATION_PRESENT",
                        "boundary:VerifiedGraph→Proposal→Ch'en→XCFE→XulGate→B'"],

