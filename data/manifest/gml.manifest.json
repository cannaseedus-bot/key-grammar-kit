{
  "gml:loader":        ["main.cpp:7876", "scan:data/*.gml", "auto-loaded-at-startup", "consumer:field_dag.load_gml", "consumer:mcp_server.add_gml", "id-namespace:@node:gml:{stem}:{int_id}"],
  "gml:grammar":       ["data/grammar/gml.khanary.ebnf", "parser:src/world/gml_parser.cpp"],
