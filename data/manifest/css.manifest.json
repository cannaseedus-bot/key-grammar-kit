{
  "⟁KEYGRAMMAR": ["key:address(book)", "book:declared-neighborhood", "grammar:constrained-book-traversal", "phase:Wo", "phase:Yax", "phase:Ch'en"],
  "⟁GRAMMARSYNTAXGRAPH": ["nodes:css-keys", "edges:key-expansion", "graph:persistent", "unfold:instance-tree"],
  "⟁AST": ["Abstract Syntax Transpiler", "html/css->canonical-keys", "normalization-only", "not:execution-authority"],
  "⟁SYNTAXCOMPILER": ["SyntaxCompiler.cs", "SyntaxParser", "KeyResolver", "BookExpander", "RelationBinder", "SyntaxGraphBuilder", "FoldBuilder", "SyntaxProjector"],
  "⟁SYNTAXUNITKINDS": ["Atom", "Snippet", "Block", "Component", "Layout", "File", "Application"],
  "⟁TYPE:BGPANEL": ["kind:snippet", "language:css", "⟁BGpanel"],
  "⟁TYPE:BTNPRIMARY": ["kind:snippet", "language:css", "⟁BTNPRIMARY"],
  "⟁TYPE:PANEL": ["kind:block", "language:css", "⟁PANEL"],
  "⟁TYPE:CARD": ["kind:block", "language:css", "⟁CARD"],
  "⟁TYPE:WIDGETCARD": ["kind:component", "language:html+css", "⟁WIDGETCARD"],
  "⟁TYPE:WIDGET": ["kind:component", "language:html+css", "⟁WIDGET"],
  "⟁TYPE:HTMLPAGE": ["kind:layout", "language:html+css", "⟁HTMLPAGE"],
  "⟁TYPE:BLOGLAYOUT": ["kind:layout", "language:html+css", "⟁BLOGLAYOUT"],
  "⟁TYPE:DOGWALKAPP": ["kind:application", "language:html+css", "⟁DOGWALKAPP"],
  "⟁HTMLBIND": ["html:element->css:key", "channel:syntax+semantic", "projection:style-binding"],
  "⟁HTMLARTICLE": ["⟁WIDGETCARD", "role:article", "⟁HTMLBIND"],
  "⟁HTMLHEADING1": ["⟁H1", "role:heading", "level:1", "⟁HTMLBIND"],
  "⟁HTMLPARAGRAPH": ["⟁P", "role:paragraph", "⟁HTMLBIND"],
  "⟁HTMLCLASSATTR": ["semantic:classification", "bind:class->style-key", "⟁HTMLBIND"],
  "⟁PANEL":    ["⟁BGpanel", "⟁BRlg", "padding:20px", "⟁BORDER"],
  "⟁CARD":     ["⟁PANEL", "box-shadow:0 8px 32px rgba(0,0,0,0.2)"],
  "⟁BGpanel":  ["background:#020b12"],
  "⟁BGalt":    ["background:#050b1c"],
  "⟁BGterm":   ["background:#01040a"],
  "⟁BRsm":     ["border-radius:0.375rem"],
  "⟁BRmd":     ["border-radius:0.75rem"],
  "⟁BRlg":     ["border-radius:1.25rem"],
  "⟁BORDER":   ["border:1px solid rgba(148,163,184,0.5)"],
  "⟁BORDERglow":["border:1px solid rgba(56,189,248,0.9)"],
  "⟁FLEX":     ["display:flex"],
  "⟁FLEXROW":  ["⟁FLEX", "flex-direction:row"],
  "⟁FLEXCOL":  ["⟁FLEX", "flex-direction:column"],
  "⟁GRID":     ["display:grid"],
  "⟁GRID2":    ["⟁GRID", "grid-template-columns:1fr 1fr"],
  "⟁GRID3":    ["⟁GRID", "grid-template-columns:1fr 1fr 1fr"],
  "⟁GAP":      ["gap:1rem"],
  "⟁GAPSM":    ["gap:0.5rem"],
  "⟁GAPLG":    ["gap:1.5rem"],
  "⟁Pprimary": ["color:#22f2b3"],
  "⟁Psecondary":["color:#38bdf8"],
  "⟁Paccent":  ["color:#a855f7"],
  "⟁Pdanger":  ["color:#fb7185"],
  "⟁Pwarning": ["color:#facc15"],
  "⟁Psuccess": ["color:#4ade80"],
  "⟁TEXT":     ["color:#e5f2ff"],
  "⟁TEXTsoft": ["color:#9ca3af"],
  "⟁TEXTfaint":["color:#6b7280"],
  "⟁TEXTstrong":["color:#f9fafb"],
  "⟁MONO":     ["font-family:ui-monospace,monospace"],
  "⟁SANS":     ["font-family:system-ui,sans-serif"],
  "⟁HUD":      ["⟁FLEXROW", "⟁GAP", "⟁BORDERglow", "⟁BRmd", "padding:8px 16px"],
  "⟁DIALOG":   ["⟁CARD", "⟁Psecondary", "min-width:320px"],
  "⟁NAV":      ["⟁FLEXROW", "⟁GAP", "⟁BGpanel", "⟁BORDER", "padding:8px 12px"],
  "⟁FORMKIT":  ["⟁FLEXCOL", "⟁GAP", "⟁TEXT"],
  "⟁FIELDSET": ["⟁FLEXCOL", "⟁GAPSM"],
  "⟁LABEL":    ["⟁TEXTsoft", "font-size:0.875rem", "font-weight:600"],
  "⟁CTRLBASE": ["⟁SANS", "⟁TEXT", "⟁BGalt", "⟁BORDER", "⟁BRmd", "padding:10px 12px", "line-height:1.4"],
  "⟁INPUT":    ["⟁CTRLBASE", "min-height:40px"],
  "⟁TEXTAREA": ["⟁CTRLBASE", "min-height:96px", "resize:vertical"],
  "⟁SELECT":   ["⟁CTRLBASE", "appearance:none"],
  "⟁CHECKROW": ["⟁FLEXROW", "⟁GAPSM", "align-items:center"],
  "⟁BTNBASE":  ["⟁SANS", "⟁BORDER", "⟁BRmd", "padding:10px 14px", "font-weight:600", "cursor:pointer", "transition:all .12s ease"],
  "⟁BTNPRIMARY":["⟁BTNBASE", "⟁Pprimary", "⟁BORDERglow", "background:#02281e"],
  "⟁BTNSECONDARY":["⟁BTNBASE", "⟁Psecondary", "background:#0b1a2a"],
  "⟁BTNDANGER":["⟁BTNBASE", "⟁Pdanger", "background:#2a0b14"],
  "⟁BTNGHOST": ["⟁BTNBASE", "background:transparent", "⟁TEXTsoft"],
  "⟁FORMDEFAULTS":["⟁FORMKIT", "⟁FIELDSET", "⟁LABEL", "⟁INPUT", "⟁BTNPRIMARY"],
  "⟁WIDGETBTN":["⟁BTNPRIMARY", "⟁HUD", "min-width:44px", "min-height:44px", "justify-content:center"],
  "⟁ICONBTN":  ["⟁WIDGETBTN", "⟁MONO", "font-size:1.125rem", "padding:8px"],
  "⟁WIDGETCARD":["⟁CARD", "⟁FLEXCOL", "⟁GAP", "padding:16px", "min-width:280px"],
  "⟁WIDGETHEADER":["⟁FLEXROW", "justify-content:space-between", "align-items:center", "⟁TEXTstrong"],
  "⟁WIDGETBODY":["⟁FLEXCOL", "⟁GAPSM", "⟁TEXT"],
  "⟁WIDGETFOOTER":["⟁FLEXROW", "⟁GAPSM", "justify-content:flex-end"],
  "⟁MODALBACKDROP":["position:fixed", "inset:0", "background:rgba(2,11,18,0.66)", "backdrop-filter:blur(2px)"],
  "⟁MODALCARD":["⟁WIDGETCARD", "⟁BORDERglow", "max-width:640px", "margin:auto"],
  "⟁WIDGETMODAL":["⟁MODALBACKDROP", "⟁FLEX", "align-items:center", "justify-content:center", "padding:24px"],
  "⟁WIDGETDOCK":["⟁FLEXROW", "⟁GAPSM", "⟁BGpanel", "⟁BORDER", "⟁BRlg", "padding:8px 10px"],
  "⟁WIDGETGRID":["⟁GRID", "grid-template-columns:repeat(auto-fill,minmax(220px,1fr))", "⟁GAP"],
  "⟁WIDGET":   ["⟁WIDGETCARD", "⟁WIDGETHEADER", "⟁WIDGETBODY", "⟁WIDGETFOOTER", "⟁WIDGETBTN"],
  "⟁HTMLROOT": ["⟁SANS", "⟁TEXT", "⟁BGterm", "min-height:100vh", "margin:0"],
  "⟁HTMLSHELL":["⟁HTMLROOT", "⟁FLEXCOL", "⟁GAPLG", "padding:24px"],
  "⟁HTMLPAGE": ["⟁HTMLSHELL", "⟁GRID", "grid-template-columns:280px 1fr", "⟁GAPLG"],
  "⟁HTML":     ["⟁HTMLROOT", "⟁HTMLSHELL", "⟁APP", "⟁WIDGETGRID"],
  "⟁HTMLTITLE":["⟁TEXTstrong", "font-size:2rem", "line-height:1.15", "margin:0"],
  "⟁HTMLMETA": ["⟁TEXTsoft", "font-size:0.875rem", "line-height:1.4"],
  "⟁H1":       ["⟁HTMLTITLE"],
  "⟁H2":       ["⟁TEXTstrong", "font-size:1.25rem", "line-height:1.35", "margin:0.6rem 0 0.3rem"],
  "⟁P":        ["⟁TEXT", "line-height:1.75", "margin:0.45rem 0"],
  "⟁LIST":     ["⟁FLEXCOL", "⟁GAPSM", "padding-left:1.25rem"],
  "⟁LISTITEM": ["⟁TEXT", "line-height:1.55"],
  "⟁MEDIAFRAME":["⟁CARD", "overflow:hidden", "display:block"],
  "⟁IMAGECREDIT":["⟁TEXTsoft", "font-size:0.75rem", "opacity:0.88"],
  "⟁BLOGLAYOUT":["⟁HTMLPAGE", "grid-template-columns:minmax(220px,280px) 1fr", "align-items:start"],
  "⟁BLOGPOSTCARD":["⟁WIDGETCARD", "max-width:72ch", "margin:0 auto"],
  "⟁BLOGTITLE":["⟁TEXTstrong", "font-size:1.75rem", "line-height:1.2"],
  "⟁BLOGMETA": ["⟁TEXTsoft", "font-size:0.8125rem", "⟁FLEXROW", "⟁GAPSM"],
  "⟁BLOGBODY": ["⟁TEXT", "line-height:1.75", "font-size:1rem"],
  "⟁BLOGEDITOR":["⟁FORMKIT", "⟁TEXTAREA", "⟁BTNPRIMARY", "min-height:320px"],
  "⟁BLOGTOOLBAR":["⟁NAV", "⟁BTNSECONDARY", "⟁BTNGHOST", "justify-content:space-between"],
  "⟁BLOGMODAL":["⟁WIDGETMODAL", "⟁MODALCARD", "⟁BLOGEDITOR"],
  "⟁BLOG":     ["⟁BLOGLAYOUT", "⟁BLOGPOSTCARD", "⟁BLOGTITLE", "⟁BLOGMETA", "⟁BLOGBODY", "⟁BLOGEDITOR"],
  "⟁DOGWALKCARD":["⟁BLOGPOSTCARD", "⟁WIDGET", "⟁ICONBTN", "border-left:3px solid #4ade80"],
  "⟁DOGWALKROUTE":["⟁CARD", "⟁TEXT", "⟁Psuccess", "min-height:220px", "background:linear-gradient(180deg,#052012,#02120a)"],
  "⟁DOGWALKSCHED":["⟁FORMKIT", "⟁INPUT", "⟁SELECT", "⟁BTNPRIMARY", "⟁CHECKROW"],
  "⟁DOGWALKAPP": ["⟁BLOG", "⟁DOGWALKCARD", "⟁DOGWALKROUTE", "⟁DOGWALKSCHED"],
  "⟁MX2LM":    ["⟁CARD", "⟁MONO", "⟁Psecondary", "⟁BORDERglow", "letter-spacing:0.02em"],
  "⟁MX2LMGRAM":["⟁MX2LM", "⟁GAPSM", "text-transform:uppercase"],
  "⟁APP":      ["⟁DIALOG", "⟁HUD", "⟁NAV"]
}
